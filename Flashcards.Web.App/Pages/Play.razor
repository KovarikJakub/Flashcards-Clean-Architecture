@page "/play/{Id:guid}"
@layout PlayLayout
@inherits PageBase
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="w-full h-full flex flex-col items-center px-4">
    @if (!_showStats)
    {  
        <div>
            <PlayWindow _cardCollection="_cardCollection" _index="_index" OnFlip="FlipCard" OnNext="HandleClickNext" OnBack="HandleClickBack"
                        OnMarkCorrect="HandleMarkCorrectAsync" OnMarkWrong="HandleMarkWrongAsync" IsAnswered="IsAnswered" GetAnswerState="@(id => GetAnswerState(id).ToString())" />
        </div>
    }
    else
    { 
        <div>
            <!--
                TODO: _newLesson should only serve for creating a new lesson via API
                      after creating a new lesson, we should obtain the lesson DetailModel by its ID via API
                <LessonStatistics Lesson="@_newLesson" OnPlayAgain="@HandlePlayAgain" OnTryDifferent="@HandleTryDifferentCollection"/>
            -->
        </div>
    }
</div>

@code {
}
