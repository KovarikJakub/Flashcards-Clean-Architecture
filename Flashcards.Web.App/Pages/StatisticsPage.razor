@page "/statistics"
@page "/stats"
@attribute [Authorize]
@using Flashcards.Web.BL.Api
@using Microsoft.AspNetCore.Authorization

@inject IUserApiClient UserClient
@inject AuthenticationStateProvider AuthStateProvider

<div class="container mx-auto px-4 py-8 max-w-5xl">

    <div class="mb-10 flex items-center space-x-5">
        <div class="h-16 w-16 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-lg">
            <span class="text-white text-2xl font-bold">@GetInitials(userName)</span>
        </div>

        <div>
            <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-2">
                @userName's Statistics 📊
            </h1>
            <p class="text-gray-500 mt-1">
                Overview of your learning progress and recent activity.
            </p>
        </div>
    </div>

    @if (isLoading)
    {
            <div class="animate-pulse space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="h-32 bg-gray-200 rounded-xl"></div>
                    <div class="h-32 bg-gray-200 rounded-xl"></div>
                    <div class="h-32 bg-gray-200 rounded-xl"></div>
                </div>
                <div class="h-64 bg-gray-200 rounded-xl w-full"></div>
            </div>
    }
    else if (lessons == null || !lessons.Any())
    {
            <div class="bg-blue-50 border-l-4 border-blue-500 p-6 rounded-md shadow-sm">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-6 w-6 text-blue-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-blue-800">No stats found</h3>
                        <p class="mt-1 text-blue-700">
                            It looks like you haven't completed any lessons yet. Start a study session to see your data here!
                        </p>
                    </div>
                </div>
            </div>
    }
    else
    {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">

                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex items-center justify-between transition hover:shadow-md">
                    <div>
                        <p class="text-sm font-medium text-gray-500 uppercase tracking-wider">Total Sessions</p>
                        <p class="text-3xl font-bold text-gray-900 mt-1">@lessons.Count</p>
                    </div>
                    <div class="text-4xl opacity-80 bg-gray-50 p-3 rounded-full">🎓</div>
                </div>

                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex items-center justify-between transition hover:shadow-md">
                    <div>
                        <p class="text-sm font-medium text-gray-500 uppercase tracking-wider">Cards Reviewed</p>
                        <p class="text-3xl font-bold text-blue-600 mt-1">@TotalCardsSeen</p>
                    </div>
                    <div class="text-4xl opacity-80 bg-blue-50 p-3 rounded-full">🗂️</div>
                </div>

                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex items-center justify-between transition hover:shadow-md">
                    <div>
                        <p class="text-sm font-medium text-gray-500 uppercase tracking-wider">Average Accuracy</p>
                        <p class="text-3xl font-bold @GetAccuracyColor(GlobalAccuracy) mt-1">
                        @GlobalAccuracy.ToString("F1")%
                        </p>
                    </div>
                    <div class="text-4xl opacity-80 bg-green-50 p-3 rounded-full">🎯</div>
                </div>
            </div>

            <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
                    <h3 class="text-lg font-medium text-gray-900">Recent Activity</h3>
                    <span class="text-xs text-gray-400">Last @lessons.Count sessions</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Collection</th>
                                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Score</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Accuracy</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var lesson in lessons.OrderByDescending(l => l.Start))
                        {
                            var accuracy = CalculateAccuracy(lesson.Correct, lesson.Wrong);
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    @lesson.Start.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                        </td>

                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="flex items-center">
                                                <span class="text-xl mr-3">📚</span>
                                                <div class="text-sm font-medium text-gray-900">
                                            @lesson.CardCollectionTitle
                                                </div>
                                            </div>
                                        </td>

                                        <td class="px-6 py-4 whitespace-nowrap text-center">
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200 mr-2">
                                        @lesson.Correct Correct
                                            </span>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 border border-red-200">
                                        @lesson.Wrong Wrong
                                            </span>
                                        </td>

                                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-bold @GetAccuracyColor(accuracy)">
                                    @accuracy.ToString("F0")%
                                        </td>
                                    </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
    }
</div>

@code {
    private List<LessonListModel>? lessons;
    private string userName = "User"; 
    private bool isLoading = true;
    private string? _userId;
    [Inject]
    private UserFacade UserFacade { get; set; } = null!;
    [Inject]
    private LessonFacade LessonFacade { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            try
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                if (user.Identity?.IsAuthenticated == true)
                {
                    _userId = user.FindFirst("sub")?.Value;
                    var userModel = await UserFacade.GetByIdentityIdAsync(_userId);
                    userName = userModel.Name;

                    var query = new LessonQueryModel { UserId = userModel.Id }; // get lessons just for this user 
                    // TODO: QUERY endpoints now return PagedResult<TEntity> and not IList<TEntity> !!!
                    //lessons = await LessonFacade.GetByQueryAsync(query);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to retrieve auth state: {ex.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stats: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private long TotalCardsSeen => lessons?.Sum(l => (long)l.Seen) ?? 0;

    private double GlobalAccuracy
    {
        get
        {
            if (lessons == null || !lessons.Any()) return 0;
            double totalCorrect = lessons.Sum(l => (double)l.Correct);
            double totalWrong = lessons.Sum(l => (double)l.Wrong);
            double totalAnswers = totalCorrect + totalWrong;
            return totalAnswers == 0 ? 0 : (totalCorrect / totalAnswers) * 100;
        }
    }

    private double CalculateAccuracy(double correct, double wrong)
    {
        double total = correct + wrong;
        if (total == 0) return 0;
        return (correct / total) * 100;
    }

    private string GetAccuracyColor(double accuracy) => accuracy switch
    {
        >= 80 => "text-green-600",
        >= 50 => "text-yellow-600",
        _ => "text-red-600"
    };

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        return name.Trim().Substring(0, 1).ToUpper();
    }
}