@page "/collections/edit/{Id:guid}"
@layout PlayLayout
@inherits PageBase

<div class="h-full w-full flex items-center justify-center mt-6">

    <div class="w-full max-w-[1100px] bg-white border border-blue-500 rounded-xl p-6 shadow-lg flex flex-col gap-4">
        
        <div class="text-center text-3xl font-bold leading-tight text-gray-900">
            Edit Card Collection
        </div>
        
        <div class="grid grid-cols-1 gap-4">
            
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Title</label>
                <input class="w-full px-3 py-1.5 border rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-blue-400"
                       @bind="_cardCollection.Title" />
            </div>
            
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Answer start</label>
                    <input type="datetime-local"
                           class="w-full px-3 py-1.5 border rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-blue-400"
                           @bind="_cardCollection.AnswerStart" />
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Answer end</label>
                    <input type="datetime-local"
                           class="w-full px-3 py-1.5 border rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-blue-400"
                           @bind="_cardCollection.AnswerEnd" />
                </div>
            </div>
        </div>
        
        <div>
            <div class="text-xl font-bold text-gray-800 mb-2">Cards</div>

            <div class="flex flex-col gap-4">
                @foreach (var card in _cardCollection.Cards)
                {
                    <CardForm Card="card" OnRemove="@((c) => DeleteCard(c))" />
                }
            </div>
        </div>
        
        <div class="border border-gray-300 rounded-xl p-4 shadow-sm bg-gray-50 flex flex-col gap-4 mt-4">
            
            <div class="text-lg font-semibold text-gray-800">
                Add new card
            </div>
            
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Question type</label>
                    <select class="w-full px-3 py-1.5 border rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-blue-400"
                            @bind="NewCard.QuestionType">
                        <option value="">Select type...</option>
                        @foreach (var type in Enum.GetValues<ContentType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Answer type</label>
                    <select class="w-full px-3 py-1.5 border rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-blue-400"
                            @bind="NewCard.AnswerType">
                        <option value="">Select type...</option>
                        @foreach (var type in Enum.GetValues<ContentType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Question</label>
                <textarea class="w-full px-3 py-2 border rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-blue-400"
                          rows="2"
                          @bind="NewCard.QuestionContent"></textarea>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Answer</label>
                <textarea class="w-full px-3 py-2 border rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-blue-400"
                          rows="2"
                          @bind="NewCard.AnswerContent"></textarea>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Description (optional)</label>
                <input class="w-full px-3 py-1.5 border rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-blue-400"
                       @bind="NewCard.Description"/>
            </div>
            
            <div class="flex justify-end">
                <button class="px-5 py-2 bg-blue-500 text-white rounded-lg text-base font-semibold hover:bg-blue-600"
                        @onclick="@(() => HandleAddNewCard(NewCard))">
                    Add card
                </button>
            </div>
        </div>
        
        <div class="flex justify-end gap-4 mt-4 w-full">
            <button class="px-5 py-2 text-base text-blue-500 border border-blue-500 rounded-lg font-semibold 
                           hover:bg-blue-500 hover:text-white transition"
                    @onclick="@(() => HandleAddNewCard(NewCard))">
                Add card
            </button>

            <button class="px-5 py-2 text-base text-white bg-blue-600 rounded-lg font-semibold 
                           hover:bg-blue-700 transition"
                    @onclick="@SaveCollection">
                Save
            </button>
        </div>

    </div>

</div>


