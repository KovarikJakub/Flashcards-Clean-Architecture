@page "/users"
@namespace Flashcards.Web.App.Pages.Users
@layout ListLayout
@inherits PageBase

@using Flashcards.Common.Models

<h3 class="text-2xl font-semibold mb-4">Users</h3>

<div class="bg-white shadow-sm rounded-md p-4">
    <div class="flex items-center justify-between mb-4">
        <div></div>
        <button class="bg-blue-600 hover:bg-blue-700 text-white text-sm px-3 py-1 rounded" @onclick="AddNewUser">Create new user</button>
    </div>

    <div class="flex flex-col space-y-3">
        @if (Users == null)
        {
            <p class="text-gray-500">Loading...</p>
        }
        else
        {
            @foreach (var u in Users)
            {
                <div class="bg-gray-50 border border-gray-200 rounded p-3">
                    <div class="flex items-center">
                        <div class="flex-grow">
                            <input class="border border-gray-300 rounded px-2 py-1 w-full text-sm" @bind="u.Name" />
                        </div>
                        <div class="ml-2">
                            <button class="text-sm text-red-600 hover:text-red-800 px-2 py-1 rounded border border-red-200" @onclick="() => DeleteUser(u)">Delete</button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="mt-4">
        <button class="bg-green-600 hover:bg-green-700 text-white text-sm px-3 py-1 rounded" @onclick="SaveAll">Save all</button>
    </div>
</div>
