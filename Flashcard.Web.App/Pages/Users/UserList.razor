@page "/users"
@namespace Flashcards.Web.App.Pages.Users
@layout ListLayout
@inherits PageBase

@using Flashcards.Common.Models

<h3 class="text-2xl font-semibold mb-4">Users</h3>

<div class="bg-white shadow-sm rounded-md p-4">
    <div class="flex items-center justify-between mb-4">
        <div></div>
        <button class="bg-blue-600 hover:bg-blue-700 text-white text-sm px-4 py-2 rounded-md transition" @onclick="ShowCreateForm">
            <span class="mr-1">+</span> Create new user
        </button>
    </div>

    @if (IsCreating)
    {
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 mb-6">
            <h4 class="text-lg font-semibold mb-4 text-gray-800">Create New User</h4>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                    <input type="text" 
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                           @bind="NewUser.FullName" 
                           placeholder="John Doe" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Username</label>
                    <input type="text" 
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                           @bind="NewUser.UserName" 
                           placeholder="johndoe" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input type="email" 
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                           @bind="NewUser.Email" 
                           placeholder="john@example.com" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                    <input type="password" 
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                           @bind="NewUser.Password" 
                           placeholder="••••••••" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Profile Picture URL</label>
                    <input type="url" 
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                           @bind="NewUser.ProfilePicUrl" 
                           placeholder="https://example.com/avatar.jpg" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
                    <select class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                            @bind="NewUser.Role">
                        <option value="@Flashcards.Common.Enums.RoleType.User">User</option>
                        <option value="@Flashcards.Common.Enums.RoleType.Admin">Admin</option>
                    </select>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="mt-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md">
                    <p class="text-sm">@ErrorMessage</p>
                </div>
            }

            <div class="flex gap-3 mt-6">
                <button class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md transition" 
                        @onclick="CreateUser"
                        disabled="@IsSubmitting">
                    @if (IsSubmitting)
                    {
                        <span>Creating...</span>
                    }
                    else
                    {
                        <span>Create User</span>
                    }
                </button>
                <button class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-md transition" 
                        @onclick="CancelCreate"
                        disabled="@IsSubmitting">
                    Cancel
                </button>
            </div>
        </div>
    }

    <div class="flex flex-col space-y-3">
        @if (Users == null)
        {
            <p class="text-gray-500">Loading...</p>
        }
        else
        {
            @foreach (var u in Users)
            {
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 hover:shadow-md transition">
                    <div class="flex items-center">
                        <div class="flex-grow">
                            <input class="border border-gray-300 rounded px-3 py-2 w-full text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" 
                                   @bind="u.Name" 
                                   placeholder="User name" />
                        </div>
                        <div class="ml-3 flex items-center gap-2">
                            <span class="text-xs px-2 py-1 rounded @(u.Role == Flashcards.Common.Enums.RoleType.Admin ? "bg-purple-100 text-purple-700" : "bg-blue-100 text-blue-700")">
                                @u.Role
                            </span>
                            <button class="text-sm text-red-600 hover:text-red-800 px-3 py-1 rounded border border-red-200 hover:bg-red-50 transition" 
                                    @onclick="() => DeleteUser(u)">
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="mt-6">
        <button class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md transition" @onclick="SaveAll">
            Save all changes
        </button>
    </div>
</div>
