@namespace Flashcards.Web.App.Components


<div class="w-[425px] h-[350px]  rounded p-4 bg-white @Class">
    <EditForm Model="@Model" OnValidSubmit="@HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="flex flex-col  border h-[350px]">

            <!-- nadpis -->
            <div class="flex items-center justify-center border p-3">
                <label class="text-xl font-bold text-center w-full">Create new card collection</label>
            </div>

            <!-- Title -->
            <div class="flex items-center gap-4 border p-2">
                <label class="ml-5 w-10">Title:</label>
                <InputText class="border w-full p-2 flex-1" @bind-Value="Model.Title" />
            </div>

            <!-- Answer start -->
            <div class="flex items-center gap-4 border p-2">
                <label class="ml-5 w-25">Answer start:</label>
                <InputDate class="border p-2 flex-1"
                           @bind-Value="Model.AnswerStart"
                           TValue="DateTime" />
            </div>

            <!-- Answer end -->
            <div class="flex items-center gap-4 border p-2">
                <label class="ml-5 w-25">Answer end:</label>
                <InputDate class="ml-2 border p-2 flex-1"
                           @bind-Value="Model.AnswerEnd"
                           TValue="DateTime" />
            </div>

            <!-- Cards -->
            <div class="flex items-center border p-3">
                <label class="ml-5 w-32">Cards:</label>
            </div>

            <!-- Buttons -->
            <div class="flex justify-between border p-2 mt-auto">
                <button class="bg-blue-500 text-white px-4 py-2 rounded">Create</button>
                <button class="bg-gray-500 text-white px-4 py-2 rounded">Cancel</button>
            </div>

        </div>
    </EditForm>
</div>




@code {
    [Parameter] public string? Class { get; set; }

    [Parameter, EditorRequired]
    public CardCollectionDetailModel Model { get; set; } = default!;
    
    [Parameter]
    public EventCallback<CardCollectionDetailModel> Submit { get; set; }
    
    private async Task HandleSubmit()  {
        if(Submit.HasDelegate) {
            await Submit.InvokeAsync(Model);
        }
    }

}