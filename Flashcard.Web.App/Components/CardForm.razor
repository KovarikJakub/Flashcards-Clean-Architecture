@namespace Flashcards.Web.App.Components

<div class="card-form card p-2 mb-2">
    <div class="d-flex gap-2">
        <input class="form-control form-control-sm" @bind="Card.QuestionContent" placeholder="Question" />
        <input class="form-control form-control-sm" @bind="Card.AnswerContent" placeholder="Answer" />
        <select class="form-select form-select-sm" @bind="Card.QuestionType">
            @foreach (var t in Enum.GetValues<ContentType>())
            {
                <option value="@t">@t</option>
            }
        </select>
        <select class="form-select form-select-sm" @bind="Card.AnswerType">
            @foreach (var t in Enum.GetValues<ContentType>())
            {
                <option value="@t">@t</option>
            }
        </select>
        <button class="btn btn-sm btn-outline-danger" @onclick="Remove">Remove</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public CardDetailModel Card { get; set; } = null!;

    [Parameter]
    public EventCallback<CardDetailModel> OnRemove { get; set; }

    private async Task Remove()
    {
        if (OnRemove.HasDelegate)
        {
            await OnRemove.InvokeAsync(Card);
        }
    }
}
