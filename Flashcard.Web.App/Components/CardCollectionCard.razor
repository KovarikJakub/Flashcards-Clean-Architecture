@namespace Flashcards.Web.App.Components

<div class="h-full border rounded shadow">
    <div class="flex flex-col p-4">
        <h5 class="text-lg font-bold">@Collection.Title</h5>
        <p class="text-sm text-gray-500 mb-2"><small>@Collection.Id</small></p>

        <div class="mt-auto">
            <p class="mb-1 font-semibold">Answer window</p>
            <p class="mb-0 text-xs">@Collection.AnswerStart:G - @Collection.AnswerEnd:G</p>
        </div>

        <div class="mt-3 flex gap-2">
            <button class="px-3 py-1 text-sm text-blue-500 border border-blue-500 rounded hover:bg-blue-500 hover:text-white" @onclick="EditClicked">Edit</button>
            <button class="px-3 py-1 text-sm text-red-500 border border-red-500 rounded hover:bg-red-500 hover:text-white" @onclick="DeleteClicked">Delete</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public CardCollectionListModel Collection { get; set; } = null;

    [Parameter]
    public EventCallback<CardCollectionListModel> OnEdit { get; set; }

    [Parameter]
    public EventCallback<CardCollectionListModel> OnDelete { get; set; }

    private async Task EditClicked()
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync(Collection);
        }
    }

    private async Task DeleteClicked()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(Collection);
        }
    }
}