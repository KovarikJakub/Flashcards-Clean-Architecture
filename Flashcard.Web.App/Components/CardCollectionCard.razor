@namespace Flashcards.Web.App.Components

<div class="border rounded shadow @Class">
    <div class="flex flex-col p-4 h-full">

        <div class="flex items-center justify-center border p-3 ">
            <label class="text-xl font-bold text-center w-full">@Collection.Title</label>
        </div>

        <div class="flex items-center justify-center border mt-3 p-3">
            <label class="text-lg font-semibold text-center w-full">Answer window</label>
        </div>

        <div class="flex  border p-3">
            <label class="text-lg font-semibold  w-full">start: @Collection.AnswerStart</label>
        </div>
        
        <div class="flex items-center justify-center border p-3">
            <label class="text-lg font-semibold  w-full">end: @Collection.AnswerEnd:G</label>
        </div>
        
        @if (IsOwner)
        {
           <div class="mt-10 flex justify-between items-center">
            <button class="px-4 py-2 text-sm text-blue-500 border border-blue-500 rounded hover:bg-blue-500 hover:text-white" @onclick="HandlePlayClicked">Play</button>
            <div class="flex gap-2">
                <button class="px-4 py-2 text-sm text-green-500 border border-green-500 rounded hover:bg-green-500 hover:text-white" @onclick="EditClicked">Edit</button>
                <button class="px-4 py-2 text-sm text-red-500 border border-red-500 rounded hover:bg-red-500 hover:text-white" @onclick="DeleteClicked">Delete</button>
            </div>
        </div>
        }
        else
        {
            <div class="mt-10 flex justify-center items-center">
                <button class="w-[100px] font-bold text-3xl text-blue-500 border border-blue-500 rounded hover:bg-blue-500 hover:text-white" 
                        @onclick="HandlePlayClicked">Play</button>
            </div>
        }
        
        
   
    </div>
</div>



    


@code {
    [Parameter] public string? Class { get; set; }
    
    [Parameter, EditorRequired]
    public CardCollectionListModel Collection { get; set; } = null;

    [Parameter]
    public EventCallback<CardCollectionListModel> OnEdit { get; set; }

    [Parameter]
    public EventCallback<CardCollectionListModel> OnDelete { get; set; }
    
    [Parameter]
    public EventCallback<CardCollectionListModel> onPlay { get; set; }
    
    [Parameter]
    public bool IsOwner { get; set; }

    private async Task EditClicked()
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync(Collection);
        }
    }

    private async Task DeleteClicked()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(Collection);
        }
    }
    
    private async Task HandlePlayClicked()
    {
        if (onPlay.HasDelegate)
        {
            await onPlay.InvokeAsync(Collection);
        }
    }
}